# Reference only. The application does NOT automatically load .env files.
# Set these in Windows User environment variables or the launching terminal.
# Never commit a real key or include it in a frontend bundle.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_BASE_URL=https://api.openai.com/v1
HOMEACCOUNTS_AI_PROVIDER=OpenAI
# Optional: existing CSV store location; default is ./data beside local_api.py
# HOMEACCOUNTS_DATA_DIR=D:\Private\HomeAccountsData
